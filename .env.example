# Copie para .env e preencha. O servidor não sobe sem as três variáveis do Discord.
#
# Como obter as credenciais:
#   1. Acesse https://discord.com/developers/applications e crie uma aplicação.
#   2. Em OAuth2, copie o Client ID e o Client Secret.
#   3. Ainda em OAuth2, cadastre a Redirect URI exatamente igual à de baixo.
#      O Discord recusa o login se houver qualquer diferença, inclusive a barra final.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Porta do processo único que serve SPA, API e WebSocket.
PORT=3000

# Arquivo SQLite. Backup é cópia deste arquivo.
DB_FILE=quest-fast.db

# Build do client servido em produção, relativo ao diretório do server.
CLIENT_DIR=../client/dist

# Cookies com Secure exigem HTTPS. Deixe vazio em desenvolvimento local;
# em produção atrás de HTTPS, use true.
COOKIE_SECURE=
