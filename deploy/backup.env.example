# Credenciais do backup no R2. Na VM: /srv/quest-fast/backup.env, dono root e
# chmod 600. Fica fora do app.env para o app nunca enxergar este token.
# Bucket sem acesso público e com regra de ciclo de vida que apaga objetos
# antigos (por exemplo, 30 dias). Token do R2 com Object Read & Write restrito
# a ele.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=
